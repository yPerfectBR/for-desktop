# Arch Linux package for Stoat Homelab, repackaged from the release tarball.
# Built in CI by .github/workflows/homelab-release.yml:
#   STOAT_VERSION=1.2.3 makepkg   (with Stoat-Homelab-linux-x64.tar.gz next to this file)

pkgname=stoat-homelab
pkgver=${STOAT_VERSION//-/_}
pkgrel=1
pkgdesc="Stoat Homelab — Stoat client for our self-hosted homelab server"
arch=(x86_64)
url="https://github.com/yPerfectBR/for-desktop"
license=(AGPL-3.0-only)
depends=(gtk3 nss alsa-lib libxss libxtst libnotify libsecret at-spi2-core libdrm mesa libpipewire xdg-utils)
optdepends=('nvidia-prime: render on the NVIDIA GPU with prime-run')
options=(!strip !debug)
source=("Stoat-Homelab-linux-x64.tar.gz" "stoat-homelab.desktop")
sha256sums=(SKIP SKIP)

package() {
  install -d "$pkgdir/opt"
  cp -a "$srcdir/StoatHomelab-linux-x64" "$pkgdir/opt/stoat-homelab"
  chmod -R u+rwX,go+rX,go-w "$pkgdir/opt/stoat-homelab"
  # Electron's setuid sandbox helper
  chmod 4755 "$pkgdir/opt/stoat-homelab/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/stoat-homelab/stoat-homelab "$pkgdir/usr/bin/stoat-homelab"

  install -Dm644 "$srcdir/stoat-homelab.desktop" \
    "$pkgdir/usr/share/applications/stoat-homelab.desktop"

  for size in 16 32 64 128 256 512; do
    install -Dm644 "$startdir/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/stoat-homelab.png"
  done
}
